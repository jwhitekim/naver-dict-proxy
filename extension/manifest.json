{
  "manifest_version": 3,
  "name": "My Dictionary",
  "version": "1.0.0",
  "description": "Look up English words in the Naver English-Korean dictionary.",
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Open My Dictionary"
    }
  },
  "host_permissions": [
    "http://localhost:3001/*"
  ]
}
