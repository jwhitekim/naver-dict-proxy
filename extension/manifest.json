{
  "manifest_version": 3,
  "name": "야매 옥스퍼드",
  "version": "1.0.0",
  "description": "정식 허가 1도 없이 네이버 사전 뒷문으로 들어가는 확장 프로그램. 서버 안 켜져 있으면 그냥 죽은 척함.",
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "야매 옥스퍼드 열기"
    }
  }
}
